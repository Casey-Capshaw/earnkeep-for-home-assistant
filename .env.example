# EarnKeep dev/deploy settings for scripts/*.sh.
# Copy to .env at the repo root (gitignored) and fill in your own values.
# Anything already exported in your shell overrides this file.

# SSH target for your Home Assistant host: an ~/.ssh/config alias or user@host.
# Required by scripts/deploy.sh (and verify-device.sh when FK_PASSWORD is unset).
EARNKEEP_HA_SSH=root@homeassistant.local

# Base URL of Home Assistant, used by deploy.sh to reload the config entry and
# verify the served bundle (required whenever an HA token is available).
EARNKEEP_HA_URL=http://homeassistant.local:8123

# Tablet running Fully Kiosk Browser (remote admin enabled). Required by
# scripts/verify-device.sh and by `FK_REFRESH=1 scripts/deploy.sh`.
# Leave the host empty if you have no tablet.
EARNKEEP_TABLET_HOST=
EARNKEEP_TABLET_PORT=2323

# Optional one-off overrides (normally leave unset):
# HA_TOKEN=     long-lived HA token; default is ~/.config/earnkeep/ha_token
# FK_PASSWORD=  Fully Kiosk password; default is read from HA over ssh
# FK_HOST=      host:port, overrides EARNKEEP_TABLET_HOST/EARNKEEP_TABLET_PORT
